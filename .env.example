# =====================================================================
#  dedup_cleaner — configuration TEMPLATE (checked in as the "pull" file)
#
#  IMPORTANT: This file contains NO real host details by design. Copy it to
#  `.env` (which is git-ignored) and fill in the real values there. The real
#  NAS root path, the Fernet key, and the state dir all live ONLY in `.env`.
#
#  Every value below is injected into the container as an env var by
#  docker-compose.yml. Do NOT edit checked-in source to change these.
# =====================================================================

# --- Scope (the sensitive, never-commit values — see `.env`) --------
# Root the scanner walks. KEEP THIS A PLACEHOLDER here; set the real path in
# `.env` only.
DEDUP_ROOT=/path/to/your/scan/root

# Preferred path(s) (space- or comma-separated). ORDER MATTERS: earlier entries
# outrank later ones — e.g. DEDUP_PREFERRED=/keeper/strong /keeper/weak keeps
# the strong copy and removes the weak one. A copy under the FIRST matching
# root wins; two copies tied at the same (top) rank are never removed.
# Non-preferred copies always lose to any preferred copy.
DEDUP_PREFERRED=/path/to/your/keeper/dir

# Excluded dir(s) (space- or comma-separated). Not scanned at all.
DEDUP_IGNORE=/path/to/your/excluded/dir

# --- Behaviour flags (safe-by-default) ------------------------------
DEDUP_DRY_RUN=true            # keep TRUE until you've reviewed a full pass
DEDUP_HASH_CHECK=false        # additive: sha256 byte-identity confirm
DEDUP_CORRUPTION_CHECK=false  # additive: 0-byte + media probe + state persist
DEDUP_ENCRYPT_FILE_NAME=false # additive: redact names, encrypt state CSV

# Extensions treated as bad (removed regardless of preference; still dry-run
# gated). Space/comma-separated. Empty = disabled.
DEDUP_BAD_FILE_TYPES=.part

# Stop scanning once this many issues are identified (resolved or ambiguous).
DEDUP_MAX_CHANGES=10

# Wall-clock budget in SECONDS for one run (0 = no limit). On expiry the
# process saves its state cache, emits a partial report, and exits WITHOUT
# deleting anything (the fix stage is always last). Recommended for network
# (CIFS/NFS) roots where a hung read could otherwise stall the container.
DEDUP_TIME_BUDGET_S=0

# --- Privacy / storage ---------------------------------------------
DEDUP_STATE_DIR=/volume/dedup/state   # mounted volume for the encrypted CSV

# Fernet key for encrypt-file-name + state CSV. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED (non-empty) when DEDUP_ENCRYPT_FILE_NAME=true, else the script
# fails fast rather than log raw names.
DEDUP_SECRET_KEY=changeme-generate-a-real-fernet-key

# MASTER SWITCH — even with DEDUP_DRY_RUN=false, deletion is a no-op unless
# this is true. Two independent tripwires against accidental data loss.
DEDUP_ALLOW_DELETE=false

DEDUP_LOG_LEVEL=INFO
